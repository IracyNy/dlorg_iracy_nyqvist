#!/usr/bin/env bash

DOWNLOADS="$HOME/Downloads"
LOGFILE="$HOME/.local/share/dlorg/dlorg.log"

if [ ! -d "$DOWNLOADS" ]; then
    echo "Fel: $DOWNLOADS finns inte. Skapa mappen först."
    exit 1
fi

if ! command -v inotifywait &> /dev/null; then
    echo "Fel: inotifywait saknas."
    echo "Installera med: sudo dnf install inotify-tools"
    exit 1
fi

mkdir -p "$(dirname "$LOGFILE")"

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOGFILE"
}

mkdir -p "$DOWNLOADS"/{docs,images,pdfs,text,videos,audio,archives,code,other}

move_file() {
    local file="$1"
    local ext="${file##*.}"
    local target="other"

    case "${ext,,}" in
        docx|doc|odt)           target="docs" ;;
        jpg|jpeg|png|gif|webp)  target="images" ;;
        pdf)                    target="pdfs" ;;
        txt|md)                 target="text" ;;
        mp4|mkv|avi|mov)        target="videos" ;;
        mp3|wav|flac)           target="audio" ;;
        zip|tar|gz|rar)         target="archives" ;;
        sh|py|js|c|java)        target="code" ;;
        *)                      target="other" ;;
    esac

    mkdir -p "$DOWNLOADS/$target"
    mv -n "$file" "$DOWNLOADS/$target/"
    log "Flyttade $(basename "$file") till $target/"
    echo "Flyttade $(basename "$file") till $target/"
}

echo "Dlorg körs – övervakar $DOWNLOADS"
log "Dlorg startades – övervakar $DOWNLOADS"

inotifywait -m -e create -e moved_to "$DOWNLOADS" --format '%f' | while read -r file; do
    if [ -f "$DOWNLOADS/$file" ]; then
        move_file "$DOWNLOADS/$file"
    fi
done
